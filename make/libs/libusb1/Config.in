config FREETZ_LIB_libusb1
	bool "libusb-1.0 (libusb-1.0.so)"
	select FREETZ_LIB_libpthread if FREETZ_TARGET_UCLIBC_HAS_multiple_libs
	default n
	help
		A library for accessing Linux USB devices (current API).

	choice
		prompt "Version" if FALSE
			default FREETZ_LIB_libusb1_WITH_VERSION_CURRENT

		config FREETZ_LIB_libusb1_WITH_VERSION_ABANDON
			bool "1.0.23"
			depends on (FREETZ_TARGET_GCC_4_MAX || FREETZ_KERNEL_VERSION_2_MAX)

		config FREETZ_LIB_libusb1_WITH_VERSION_CURRENT
			bool "1.0.30"
			depends on !(FREETZ_TARGET_GCC_4_MAX || FREETZ_KERNEL_VERSION_2_MAX)
	endchoice

